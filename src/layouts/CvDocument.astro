---
import Head from "@components/head/Head.astro";
import { getData } from "@data/getData";
import { render } from "astro:content";
import { useTranslations, type Lang } from "@i18n/ui";
import { formatDateRange } from "@data/formatDateRange";

export type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);

const {
  about,
  socialMedias,
  experienceResumeItems,
  educationResumeItems,
  projectEntries,
  skillsResumeLists,
} = await getData(lang);

const fullName = about.name + " " + about.surname;
const currentTitle = experienceResumeItems[0]?.data.roles[0]?.title ?? "";

const stripUrl = (url: string) =>
  url
    .replace(/^https?:\/\//, "")
    .replace(/^www\./, "")
    .replace(/\/$/, "");

const siteUrl = Astro.site?.href ?? "https://sjwilczynski.github.io/";
const linkedin = socialMedias.find((s) => s.id === "linkedin");

const contacts = [
  { href: about.githubUrl, label: stripUrl(about.githubUrl) },
  { href: siteUrl, label: stripUrl(siteUrl) },
  ...(linkedin
    ? [{ href: linkedin.link, label: stripUrl(linkedin.link) }]
    : []),
  { href: "mailto:" + about.email, label: about.email },
];

// Roles and their ranges are authored newest-first, so `dates[0]` is each
// role's most recent range. The company-level `overall` span reads those
// endpoints directly — from the first-listed range's start of the oldest
// (last-listed) role to the first-listed range's end of the newest role. This
// deliberately uses the listed endpoints, not a chronological min/max over all
// ranges (matching prior behavior; a gap year's earlier range doesn't widen it).
const experience = await Promise.all(
  experienceResumeItems.map(async (entry) => {
    const { subheading, roles, locations } = entry.data;
    const newest = roles[0]?.dates[0];
    const oldest = roles[roles.length - 1]?.dates[0];
    const overall =
      oldest && newest ? `${oldest.start} – ${newest.end ?? newest.start}` : "";
    const { Content } = await render(entry);
    return { company: subheading, locations, overall, roles, Content };
  }),
);

const education = await Promise.all(
  educationResumeItems.map(async (entry) => {
    const { subheading, roles, locations } = entry.data;
    const { Content } = await render(entry);
    return {
      degree: subheading,
      school: roles[0]?.title ?? "",
      dates: [
        ...roles.map((role) => role.dates.map(formatDateRange).join(", ")),
        ...locations,
      ].join(" · "),
      Content,
    };
  }),
);

const certGroup = skillsResumeLists.find((g) => g.kind === "certifications");
const skillGroups = skillsResumeLists.filter((g) => g.kind === "skills");

const projects = await Promise.all(
  projectEntries
    .filter((entry) => entry.data.title)
    .slice(0, 5)
    .map(async (entry) => ({
      title: entry.data.title,
      Content: (await render(entry)).Content,
    })),
);
---

<html lang={lang}>
  <Head
    title={"CV — " + fullName}
    fullName={fullName}
    description={about.introduction}
    lang={lang}
    noindex
  />
  <body>
    <main class="cv">
      <header class="cv-header">
        <h1>{fullName}</h1>
        <p class="contacts">
          {
            contacts.map((c, i) => (
              <Fragment>
                {i > 0 && (
                  <Fragment>
                    {" "}
                    <span class="sep">•</span>{" "}
                  </Fragment>
                )}
                <a href={c.href}>{c.label}</a>
              </Fragment>
            ))
          }
        </p>
        {currentTitle && <p class="role">{currentTitle}</p>}
        <p class="summary">{about.introduction}</p>
      </header>

      <section class="cv-section">
        <h2>{t("cv.workExperience")}</h2>
        {
          experience.map((job) => (
            <div class="entry job">
              <p class="entry-head">
                <strong>{job.company}</strong>
                {job.locations.length > 0 && (
                  <span class="muted"> · {job.locations.join(" · ")}</span>
                )}
                <span class="muted"> · {job.overall}</span>
              </p>
              <div class="positions">
                {job.roles.map((role, i) => (
                  <Fragment>
                    <p class="role-line">
                      <strong>{role.title}</strong>
                      {role.dates.length > 0 && (
                        <span class="muted">
                          {" · "}
                          {role.dates.map(formatDateRange).join(", ")}
                        </span>
                      )}
                    </p>
                    {i === 0 && (
                      <div class="body">
                        <job.Content />
                      </div>
                    )}
                  </Fragment>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <section class="cv-section section-break">
        <h2>{t("cv.projects")}</h2>
        {
          projects.map((project) => (
            <div class="entry project">
              <p class="proj-title">{project.title}</p>
              <div class="proj-desc">
                <project.Content />
              </div>
            </div>
          ))
        }
      </section>

      <section class="cv-section">
        <h2>{t("cv.skills")}</h2>
        {
          skillGroups.map((group) => (
            <p class="skill-line">
              {group.title && <strong>{group.title}: </strong>}
              {group.elements.map((e) => e.description).join(", ")}
            </p>
          ))
        }
      </section>

      {
        about.interests.length > 0 && (
          <section class="cv-section">
            <h2>{t("cv.interests")}</h2>
            <p class="skill-line">{about.interests.join(", ")}</p>
          </section>
        )
      }

      <section class="cv-section">
        <h2>{t("cv.education")}</h2>
        {
          education.map((edu) => (
            <div class="entry">
              <p class="entry-head">
                <strong>{edu.degree}</strong>
              </p>
              <p class="role-line">
                {edu.school}
                {edu.dates && <span class="muted"> · {edu.dates}</span>}
              </p>
              <div class="body">
                <edu.Content />
              </div>
            </div>
          ))
        }
      </section>

      {
        certGroup && (
          <section class="cv-section">
            <h2>{t("cv.certifications")}</h2>
            <ul class="bullets">
              {certGroup.elements.map((cert) => (
                <li>
                  {cert.link && <a href={cert.link.url}>{cert.link.text}</a>}
                  {cert.description}
                  {cert.date && <span class="muted"> · {cert.date}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </body>
</html>

<style>
  :root {
    --cv-accent: #4479a2;
    --cv-text: #2b2b2b;
    --cv-muted: #595f66;
    --cv-rule: #e2e6ea;
  }

  body {
    margin: 0;
    background: #fff;
    color: var(--cv-text);
    font-family: var(--font-body);
    line-height: 1.4;
  }

  .cv {
    max-width: 50rem;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    font-size: 0.85rem;
  }

  /* Links — "modern subtle": dark text with a thin accent underline so links
     are legible inline. `:global` is required because project descriptions and
     experience bullets are rendered from Markdown, not scoped to this file. */
  .cv :global(a) {
    color: var(--cv-text);
    text-decoration: underline;
    text-decoration-color: var(--cv-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .cv :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  /* Contacts and project titles read as accent, no underline. */
  .contacts :global(a),
  .proj-title :global(a) {
    color: var(--cv-accent);
    text-decoration: none;
  }

  .muted {
    color: var(--cv-muted);
    font-weight: 400;
  }

  /* Header */
  .cv-header h1 {
    font-family: var(--font-body);
    color: var(--cv-accent);
    font-size: 2.1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 0.25rem;
    text-transform: none;
  }

  .contacts {
    margin: 0 0 0.6rem;
    font-size: 0.82rem;
    color: var(--cv-muted);
    /* Contact URLs have no spaces; allow them to wrap so the long line never
       forces horizontal scrolling on narrow phones. */
    overflow-wrap: anywhere;
  }

  .contacts .sep {
    margin: 0 0.2rem;
    color: #aab2ba;
  }

  .role {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--cv-text);
    margin: 0 0 0.35rem;
  }

  .summary {
    margin: 0;
    max-width: 46rem;
  }

  /* Sections */
  .cv-section {
    margin-top: 1.1rem;
  }

  /* Start a fresh page so Work Experience owns page 1 on its own */
  .section-break {
    break-before: page;
  }

  .cv-section h2 {
    font-family: var(--font-body);
    color: var(--cv-accent);
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.45rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--cv-rule);
    break-after: avoid;
  }

  /* Entries */
  .entry {
    margin-bottom: 0.7rem;
    break-inside: avoid;
  }

  /* Extra breathing room between companies so they're easy to tell apart. */
  .job {
    margin-bottom: 1rem;
  }

  .entry-head {
    margin: 0;
    font-size: 1rem;
  }

  .entry-head strong {
    font-family: var(--font-body);
    font-weight: 800;
  }

  /* Roles sit indented under their company with a hairline rule. Indent is
     deliberately small so long bullet lines still fit the A4 column. */
  .positions {
    margin-left: 0.4rem;
    padding-left: 0.8rem;
    border-left: 2px solid var(--cv-rule);
  }

  .role-line {
    margin: 0.1rem 0 0.2rem;
    font-size: 0.8rem;
  }

  /* Projects: a bold accent title with its description underneath. */
  .project {
    margin-bottom: 0.55rem;
  }

  .proj-title {
    margin: 0 0 0.05rem;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--cv-accent);
  }

  .proj-desc {
    margin: 0;
  }

  .proj-desc :global(p) {
    margin: 0;
  }

  .body :global(p) {
    margin: 0.1rem 0 0.3rem;
  }

  .body :global(ul) {
    margin: 0.2rem 0;
    padding-left: 1.1rem;
  }

  .body :global(li) {
    margin: 0.1rem 0;
  }

  .bullets {
    margin: 0;
    padding-left: 1.1rem;
  }

  .bullets li {
    margin: 0.15rem 0;
  }

  .skill-line {
    margin: 0 0 0.3rem;
  }

  /* PDF / print: rely on the page margin from the generator, not page padding */
  @media print {
    .cv {
      max-width: none;
      padding: 0;
    }
  }

  @page {
    size: A4;
  }
</style>
