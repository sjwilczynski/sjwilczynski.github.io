---
import { render, type CollectionEntry } from "astro:content";

type Props = {
  entry:
    | CollectionEntry<"experience">
    | CollectionEntry<"education">
    | CollectionEntry<"research">;
};

const { entry } = Astro.props;
const { headings, subheading, extraInfos } = entry.data;
const { Content } = await render(entry);
---

<style>
  .resume-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;
  }

  .resume-content {
    margin-right: auto;
  }

  .resume-content h3 {
    margin-bottom: 0;
  }

  .resume-content .subheading {
    margin-bottom: 0.75rem;
  }

  .resume-extra {
    line-height: 2rem;
  }

  .extra-info {
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .resume-item {
      flex-direction: row;
    }

    .resume-extra {
      text-align: end;
      min-width: 18rem;
    }
  }
</style>

<div class="resume-item">
  <div class="resume-content">
    {headings.map((heading) => <h3>{heading}</h3>)}
    <div class="subheading">{subheading}</div>
    <Content />
  </div>
  <div class="resume-extra">
    {
      extraInfos.map((info) => (
        <span class="extra-info">
          {info} <br />{" "}
        </span>
      ))
    }
  </div>
</div>
