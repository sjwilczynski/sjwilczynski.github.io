---
import { render } from "astro:content";
import type { ResumeEntry } from "@data/types";

type Props = {
  entry: ResumeEntry;
};

const { entry } = Astro.props;
const { headings, subheading, extraInfos } = entry.data;
const { Content } = await render(entry);

// The content model packs each entry's roles into parallel `headings` /
// `extraInfos` arrays: the first `headings.length` extraInfos are the per-role
// date ranges, the remaining ones are locations. Pair each heading with its date
// so the date can render alongside the role it belongs to.
const roleDates = extraInfos.slice(0, headings.length);
const locations = extraInfos.slice(headings.length);
const roles = headings.map((title, index) => ({
  title,
  date: roleDates[index] ?? "",
}));

// A date may hold several ranges joined by commas (e.g. a gap year). Split them
// so each range stays intact (`nowrap`) but the ranges can wrap between one
// another, keeping the date compact enough to sit beside the title.
const toRanges = (date: string) =>
  date
    .split(",")
    .map((range) => range.trim())
    .filter(Boolean);
---

<style>
  .resume-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;
  }

  /* Query container so each role row responds to the real content-column width
     (which narrows next to the sidebar), not the viewport. */
  .roles {
    container-type: inline-size;
  }

  .role-row {
    display: flex;
    align-items: baseline;
    column-gap: 1.5rem;
  }

  .role-row + .role-row {
    margin-top: 0.15rem;
  }

  .role-row h3 {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Both title and date can shrink; the title's larger natural width means it
     wraps first, so a long date wraps its ranges in place on the right instead
     of being bumped onto its own line below. */
  .role-date {
    flex: 0 1 auto;
    min-width: 0;
    text-align: right;
    color: var(--accent);
  }

  .role-date .range {
    white-space: nowrap;
  }

  .subheading {
    margin-top: 0.5rem;
  }

  .resume-locations {
    margin-top: 0.1rem;
    color: var(--text-muted);
  }

  .resume-body {
    margin-top: 0.75rem;
  }

  /* On a narrow column the date can no longer share the row, so stack it
     directly under the title where the association stays obvious. */
  @container (max-width: 30rem) {
    .role-row {
      flex-wrap: wrap;
    }

    .role-date {
      flex-basis: 100%;
      margin-top: 0.02rem;
      text-align: left;
    }
  }
</style>

<div class="resume-item">
  <div class="roles">
    {
      roles.map((role) => (
        <div class="role-row">
          <h3>{role.title}</h3>
          {role.date && (
            <span class="role-date">
              {toRanges(role.date).map((range, index) => (
                <>
                  {index > 0 && ", "}
                  <span class="range">{range}</span>
                </>
              ))}
            </span>
          )}
        </div>
      ))
    }
  </div>
  <div class="subheading">{subheading}</div>
  {
    locations.length > 0 && (
      <p class="resume-locations">{locations.join(" · ")}</p>
    )
  }
  <div class="resume-body">
    <Content />
  </div>
</div>
