---
import { render } from "astro:content";
import type { ResumeEntry } from "@data/types";

type Props = {
  entry: ResumeEntry;
};

const { entry } = Astro.props;
const { headings, subheading, extraInfos } = entry.data;
const { Content } = await render(entry);
---

<style>
  .resume-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;
  }

  .resume-content {
    margin-right: auto;
  }

  .resume-content h3 {
    margin-bottom: 0;
    transform-origin: left center;
  }

  /* V3 row hover: hovering the entry nudges its job title to the accent colour
     and swells it slightly from the left — title only, no layout shift. */
  .resume-content:hover h3 {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .resume-content h3 {
      transition:
        transform 0.2s ease,
        color 0.2s ease;
    }

    .resume-content:hover h3 {
      transform: scale(1.025);
    }
  }

  .resume-content .subheading {
    margin-bottom: 0.75rem;
  }

  .resume-extra {
    line-height: 2rem;
  }

  .extra-info {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .resume-item {
      flex-direction: row;
    }

    .resume-extra {
      text-align: end;
      min-width: 18rem;
    }
  }
</style>

<div class="resume-item">
  <div class="resume-content">
    {headings.map((heading) => <h3>{heading}</h3>)}
    <div class="subheading">{subheading}</div>
    <Content />
  </div>
  <div class="resume-extra">
    {
      extraInfos.map((info) => (
        <span class="extra-info">
          {info} <br />{" "}
        </span>
      ))
    }
  </div>
</div>
