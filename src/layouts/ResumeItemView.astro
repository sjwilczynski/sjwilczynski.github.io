---
import { render } from "astro:content";
import type { ResumeEntry } from "@data/types";
import { formatDateRange } from "@data/formatDateRange";

type Props = {
  entry: ResumeEntry;
};

const { entry } = Astro.props;
const { subheading, roles, locations } = entry.data;
const { Content } = await render(entry);
---

<style>
  .resume-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;
  }

  /* Query container so each role row responds to the real content-column width
     (which narrows next to the sidebar), not the viewport. */
  .roles {
    container-type: inline-size;
  }

  .role-row {
    display: flex;
    /* Center the smaller accent date against the tall display-font title so it
       reads as vertically aligned with the role rather than sitting at its
       baseline. Harmless in the stacked (wrapped) layout below, where each flex
       line holds a single item. */
    align-items: center;
    column-gap: 1.5rem;
  }

  .role-row + .role-row {
    margin-top: 0.15rem;
  }

  .role-row h3 {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Both title and date can shrink; the title's larger natural width means it
     wraps first, so a long date wraps its ranges in place on the right instead
     of being bumped onto its own line below. */
  .role-date {
    flex: 0 1 auto;
    min-width: 0;
    text-align: right;
    color: var(--accent);
  }

  .role-date .range {
    white-space: nowrap;
  }

  .subheading {
    margin-top: 0.5rem;
  }

  .resume-locations {
    margin-top: 0.1rem;
    color: var(--text-muted);
  }

  .resume-body {
    margin-top: 0.75rem;
  }

  /* On a narrow column the date can no longer share the row, so stack it
     directly under the title where the association stays obvious. */
  @container (max-width: 30rem) {
    .role-row {
      flex-wrap: wrap;
    }

    .role-date {
      flex-basis: 100%;
      margin-top: 0.02rem;
      text-align: left;
    }
  }
</style>

<div class="resume-item">
  <div class="roles">
    {
      roles.map((role) => (
        <div class="role-row">
          <h3>{role.title}</h3>
          <span class="role-date">
            {role.dates.map((range, index) => (
              <>
                {index > 0 && ", "}
                <span class="range">{formatDateRange(range)}</span>
              </>
            ))}
          </span>
        </div>
      ))
    }
  </div>
  <div class="subheading">{subheading}</div>
  {
    locations.length > 0 && (
      <p class="resume-locations">{locations.join(" · ")}</p>
    )
  }
  <div class="resume-body">
    <Content />
  </div>
</div>
