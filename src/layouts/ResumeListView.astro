---
import type { ResumeList } from "@data/types";
import Icon from "@components/icons/Icon.astro";
export type Props = ResumeList;

const { elements, numColumns } = Astro.props;

const columnCount = numColumns ?? 1;
---

<style define:vars={{ columnCount }}>
  .list-grid {
    display: grid;
    --adjustedColumnCount: var(--columnCount);
    padding: 0;
    padding-left: 2rem;

    @media (width <= 450px) {
      --adjustedColumnCount: min(var(--columnCount), 2);
    }

    @media (width <= 290px) {
      --adjustedColumnCount: 1;
    }

    grid-template-columns: repeat(var(--adjustedColumnCount), 1fr);
  }

  .marker {
    min-width: 1em;
    min-height: 1em;
    display: inline-flex;
    justify-content: center;
    align-items: center;
  }

  .list-style-none {
    list-style-type: none;
    display: flex;
    gap: 0.5em;
  }

  .icon-wrapper {
    height: 1lh;
  }

  .custom-icon {
    flex-shrink: 0;
    width: 2em;
  }

  :global(.iol-icon) {
    color: #c0c0c0;
  }

  :global(.graduation-cap-icon) {
    color: #000;
  }

  :global(.award-icon) {
    color: #dc3545;
  }

  :global(.medal-icon) {
    color: #ffc107;
  }

  .item {
    margin-bottom: 0.5em;
  }
</style>

<ul class="list-grid">
  {
    elements.map(({ iconName, iconClassName, description }) => {
      const icon = iconName ? (
        <span class="icon-wrapper">
          <Icon
            name={iconName}
            class={(iconClassName ?? "") + " custom-icon"}
          />
        </span>
      ) : (
        <span class="icon-wrapper marker">•</span>
      );
      return (
        <li class={"item list-style-none"}>
          {icon}
          <span>
            <Fragment set:html={description} />
          </span>
        </li>
      );
    })
  }
</ul>
