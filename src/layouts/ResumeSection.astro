---
import ResumeItemView from "./ResumeItemView.astro";
import type { ResumeEntry } from "@data/types";
import Section from "./Section.astro";

export type Props = {
  id: string;
  title?: string;
  resumeItems?: ResumeEntry[];
};

const { resumeItems = [], title, id } = Astro.props;
---

<Section id={id} title={title}>
  {resumeItems.map((entry) => <ResumeItemView entry={entry} />)}
  <slot />
</Section>
