---
import Icon from "./Icon.astro";

export type Props = {
  iconName: string;
  link: string;
  title: string;
  download?: boolean;
};

const { iconName, link, title, download = false } = Astro.props;
---

<style>
  .icon-with-link {
    position: relative;
    display: inline-block;
    height: 3.5rem;
    width: 3.5rem;
    background-color: var(--icon-bg);
    background-image: none;
    color: var(--on-accent) !important;
    border-radius: 100%;
    text-align: center;
    font-size: 1.5rem;
    line-height: 3.5rem;
    margin-right: 1rem;
    padding-bottom: 0;

    &:last-child {
      margin-right: 0;
    }

    &:hover {
      background-color: var(--accent-fill);
    }
  }

  /* "Boop": the circle lifts and the glyph springs/tilts inside it on hover.
     The glyph (not the link) carries the rotation so the tooltip stays upright. */
  @media (prefers-reduced-motion: no-preference) {
    .icon-with-link {
      transition:
        transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
        background-color 0.2s ease;
    }

    .icon-with-link :global(svg) {
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .icon-with-link:hover,
    .icon-with-link:focus-visible {
      transform: translateY(-3px);
    }

    .icon-with-link:hover :global(svg),
    .icon-with-link:focus-visible :global(svg) {
      transform: rotate(-8deg) scale(1.12);
    }
  }

  /* CSS-only tooltip: no JS, shown on hover and keyboard focus. The accessible
     name still comes from aria-label. */
  .icon-with-link::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.6rem);
    transform: translateX(-50%) translateY(0.25rem);
    background-color: var(--icon-bg);
    color: var(--on-accent);
    font-size: 0.78rem;
    line-height: 1;
    white-space: nowrap;
    padding: 0.4rem 0.55rem;
    border-radius: 0.375rem;
    /* Kept out of layout while hidden so the (nowrap, off-screen-centered)
       tooltip can't widen the page and cause horizontal scroll on phones. */
    display: none;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      display 0.15s allow-discrete;
    z-index: 5;
  }

  .icon-with-link::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.2rem);
    transform: translateX(-50%) translateY(0.25rem);
    border: 0.375rem solid transparent;
    border-top-color: var(--icon-bg);
    display: none;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      display 0.15s allow-discrete;
    z-index: 5;
  }

  .icon-with-link:hover::after,
  .icon-with-link:focus-visible::after,
  .icon-with-link:hover::before,
  .icon-with-link:focus-visible::before {
    display: block;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Starting values for the show transition, since the tooltip animates in
     from `display: none` (which otherwise skips the transition). */
  @starting-style {
    .icon-with-link:hover::after,
    .icon-with-link:focus-visible::after,
    .icon-with-link:hover::before,
    .icon-with-link:focus-visible::before {
      opacity: 0;
      transform: translateX(-50%) translateY(0.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-with-link::after,
    .icon-with-link::before {
      transition: opacity 0.15s ease;
      transform: translateX(-50%);
    }
  }
</style>

<a
  href={link}
  class="icon-with-link"
  aria-label={title}
  data-tooltip={title}
  {...download ? { download: true } : {}}
>
  <Icon name={iconName} />
</a>
