---
import Icon from "./Icon.astro";

export type Props = {
  iconName: string;
  link: string;
  title: string;
  download?: boolean;
};

const { iconName, link, title, download = false } = Astro.props;
---

<style>
  .icon-with-link {
    position: relative;
    display: inline-block;
    height: 3.5rem;
    width: 3.5rem;
    background-color: var(--icon-bg);
    color: var(--on-accent) !important;
    border-radius: 100%;
    text-align: center;
    font-size: 1.5rem;
    line-height: 3.5rem;
    margin-right: 1rem;

    &:last-child {
      margin-right: 0;
    }

    &:hover {
      background-color: var(--accent-fill);
    }
  }

  /* CSS-only tooltip: no JS, shown on hover and keyboard focus. The accessible
     name still comes from aria-label. */
  .icon-with-link::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.6rem);
    transform: translateX(-50%) translateY(0.25rem);
    background-color: var(--icon-bg);
    color: var(--on-accent);
    font-size: 0.78rem;
    line-height: 1;
    white-space: nowrap;
    padding: 0.4rem 0.55rem;
    border-radius: 0.375rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    z-index: 5;
  }

  .icon-with-link::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.2rem);
    transform: translateX(-50%) translateY(0.25rem);
    border: 0.375rem solid transparent;
    border-top-color: var(--icon-bg);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    z-index: 5;
  }

  .icon-with-link:hover::after,
  .icon-with-link:focus-visible::after,
  .icon-with-link:hover::before,
  .icon-with-link:focus-visible::before {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-with-link::after,
    .icon-with-link::before {
      transition: opacity 0.15s ease;
      transform: translateX(-50%);
    }
  }
</style>

<a
  href={link}
  class="icon-with-link"
  aria-label={title}
  data-tooltip={title}
  {...download ? { download: true } : {}}
>
  <Icon name={iconName} />
</a>
