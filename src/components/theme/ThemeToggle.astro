---
import Icon from "../icons/Icon.astro";
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  aria-pressed="false"
  data-tooltip="Toggle dark mode"
>
  <Icon name="fa-solid:moon" class="theme-icon icon-moon" />
  <Icon name="fa-solid:sun" class="theme-icon icon-sun" />
</button>

<style>
  /* Matches the social-icon buttons so the toggle sits in the same row. */
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    width: 3.5rem;
    padding: 0;
    background-color: var(--icon-bg);
    color: var(--on-accent);
    border: none;
    border-radius: 100%;
    font-size: 1.5rem;
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background-color: var(--accent-fill);
  }

  /* Show the moon in light mode (click to go dark) and the sun in dark mode.
     The icon SVGs are rendered by a nested child component, so they don't carry
     this component's scope id — target their classes with :global(), anchored
     on the scoped .theme-toggle button. */
  .theme-toggle :global(.icon-sun) {
    display: none;
  }

  :global(html.dark) .theme-toggle :global(.icon-moon) {
    display: none;
  }

  :global(html.dark) .theme-toggle :global(.icon-sun) {
    display: inline-block;
  }
</style>

<script>
  type ViewTransitionDocument = Document & {
    startViewTransition?: (callback: () => void) => { finished: Promise<void> };
  };

  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");

  if (btn) {
    const syncPressed = () => {
      btn.setAttribute("aria-pressed", String(root.classList.contains("dark")));
    };
    syncPressed();

    btn.addEventListener("click", (event) => {
      const toDark = !root.classList.contains("dark");

      const applyTheme = () => {
        root.classList.toggle("dark", toDark);
        try {
          localStorage.setItem("theme", toDark ? "dark" : "light");
        } catch {
          /* localStorage may be unavailable (private mode) — ignore. */
        }
        syncPressed();
      };

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const doc = document as ViewTransitionDocument;

      // Unsupported browser or reduced motion: flip instantly, no animation.
      if (!doc.startViewTransition || prefersReducedMotion) {
        applyTheme();
        return;
      }

      // Radiate the new theme from the click point. Keyboard activations report
      // clientX/clientY of 0, so fall back to the button's centre.
      const rect = btn.getBoundingClientRect();
      const x = event.clientX || Math.round(rect.left + rect.width / 2);
      const y = event.clientY || Math.round(rect.top + rect.height / 2);
      root.style.setProperty("--x", `${x}px`);
      root.style.setProperty("--y", `${y}px`);

      root.classList.add("theme-transitioning");
      const transition = doc.startViewTransition(applyTheme);
      transition.finished.finally(() => {
        root.classList.remove("theme-transitioning");
      });
    });
  }
</script>
