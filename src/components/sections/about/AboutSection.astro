---
import SocialMedias from "./SocialMedias.astro";
import type { About, SocialMedia } from "@data/types";

export type Props = {
  about: About;
  socialMedias: SocialMedia[];
};

const { about, socialMedias } = Astro.props;
---

<style>
  .surname {
    color: var(--color-primary);
  }

  .about-subheading {
    margin-bottom: 3rem;
  }

  .lead {
    font-size: 1.25rem;
    font-weight: 300;
    margin-bottom: 3rem;
  }

  h1 {
    margin-bottom: 0;
  }

  @media (width <= 390px) {
    h1 {
      font-size: 4rem;
      line-height: 4.5rem;
    }
  }
  @media (width <= 290px) {
    h1 {
      font-size: 3rem;
      line-height: 3.5rem;
    }
  }
</style>

<h1>
  {about.name}
  <span class="surname"> {about.surname}</span>
</h1>
<div class="subheading about-subheading">
  {about.city}, {about.country},
  <a href={"mailto:" + about.email}> {about.email}</a>
</div>
<div class="lead">{about.introduction}</div>
<SocialMedias socialMedias={socialMedias} />
