---
import SocialMedias from "./SocialMedias.astro";
import Icon from "../../icons/Icon.astro";
import type { About, SocialMedia } from "@data/types";

export type Props = {
  about: About;
  socialMedias: SocialMedia[];
};

const { about, socialMedias } = Astro.props;

const cvPdfHref = import.meta.env.BASE_URL + "cv.pdf";
---

<style>
  .surname {
    color: var(--color-primary);
  }

  .about-subheading {
    margin-bottom: 3rem;
  }

  .lead {
    font-size: 1.25rem;
    font-weight: 300;
    margin-bottom: 3rem;
  }

  h1 {
    margin-bottom: 0;
  }

  .download-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--color-primary);
    border-radius: 2rem;
    color: var(--color-primary);
    font-weight: 800;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .download-cv:hover,
  .download-cv:focus-visible {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  @media (width <= 390px) {
    h1 {
      font-size: 4rem;
      line-height: 4.5rem;
    }
  }
  @media (width <= 290px) {
    h1 {
      font-size: 3rem;
      line-height: 3.5rem;
    }
  }
</style>

<h1>
  {about.name}
  <span class="surname"> {about.surname}</span>
</h1>
<div class="subheading about-subheading">
  {about.city}, {about.country},
  <a href={"mailto:" + about.email}> {about.email}</a>
</div>
<div class="lead">{about.introduction}</div>
<SocialMedias socialMedias={socialMedias} />
<div>
  <a
    class="download-cv"
    href={cvPdfHref}
    download
    aria-label="Download CV as PDF"
  >
    <Icon name="fa:download" />
    Download CV (PDF)
  </a>
</div>
