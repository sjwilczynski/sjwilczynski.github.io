---
import type { SocialMedia } from "@data/types";
import IconWithLink from "../../icons/IconWithLink.astro";

export type Props = {
  socialMedias: SocialMedia[];
  cvPdfHref?: string;
  cvPdfTitle?: string;
};

const {
  socialMedias,
  cvPdfHref,
  cvPdfTitle = "Download CV (PDF)",
} = Astro.props;
---

<div>
  {
    socialMedias.map((social: SocialMedia) => (
      <IconWithLink
        iconName={social.iconName}
        link={social.link}
        title={social.title}
      />
    ))
  }
  {
    cvPdfHref && (
      <IconWithLink
        iconName="fa-solid:file-pdf"
        link={cvPdfHref}
        title={cvPdfTitle}
        download
      />
    )
  }
</div>
