<div style="display: grid; margin-bottom: 0.5rem;">
  <button
    type="button"
    id="concertsToggle"
    class="concerts-toggle"
    aria-expanded="false"
    aria-controls="concertsList"
  >
    Click here to view the full concerts list
  </button>
</div>

<div id="concertsList" hidden>
  <ul class="timeline">
    {
      concerts.map((concert) => (
        <li class="timeline-element">
          <span class="timeline-date timeline-date--desktop">
            {concert.date}
          </span>
          <span
            class="timeline-icon"
            style="background: var(--color-primary); color: var(--color-white);"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              preserveAspectRatio="xMidYMid meet"
              viewBox="0 0 512 512"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="m491.938 18.813l-17.72 2.375l-89.374 11.968l-6.22.844l-1.562 6.094l-18.5 72.156l-136.187 137.28c-2.094-4.4-4.324-8.708-6.875-12.843c-7.317-11.86-18.338-22.357-34.844-25.687c-6.457-1.303-12.664-1.702-18.53-1.28c-17.602 1.26-32.182 9.775-41.69 22.5c-10.95 14.654-15.87 34.054-15.31 54.405c-36.16 4.516-66.336 31.382-80.657 64.313c-15.608 35.885-11.856 80.956 24.655 111.156c43.28 35.8 88.28 31.622 119.875 11.22c28.593-18.467 47.778-48.14 50.813-74.752c18.615-2.81 38.424-9.03 56.375-17.968c20.474-10.195 38.536-23.433 48.406-40.063l7.625-12.874l-14.908-1.22c-34.56-2.818-53.76-12.87-66.406-26.217l146-147.22l18.938 1.375l6.156.438l2.813-5.5l6.125-11.907l25.03 11.906L464 132.438l-24.53-11.656l7.655-14.874l25.844 12.28l8.03-16.874l-25.313-12.03L464 73.155L491.03 86l8.033-16.875L472.53 56.53l11.22-21.81l8.188-15.907zm-124.532 111l13.22 13.093l-200.22 201.875a61.253 61.253 0 0 0-5.062-5.717a60.956 60.956 0 0 0-8.47-7l200.532-202.25zm-235.47 210.093c10.914-.046 21.837 4.094 30.25 12.438a42.57 42.57 0 0 1 .25 60.406a42.57 42.57 0 0 1-60.405.25a42.575 42.575 0 0 1-.25-60.406c8.345-8.415 19.245-12.64 30.157-12.688z"
              />
            </svg>
          </span>
          <div class="timeline-content">
            <div class="timeline-arrow" />
            <h3>{concert.title}</h3>
            <h4>{concert.location}</h4>
            {concert.description && <p>{concert.description}</p>}
            <span class="timeline-date timeline-date--mobile">
              {concert.date}
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<script>
  function initTimelineAnimations() {
    const items = document.querySelectorAll(".timeline-element");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -40px 0px" },
    );

    items.forEach((item) => observer.observe(item));
  }

  function initConcertsToggle() {
    const toggle = document.getElementById("concertsToggle");
    const list = document.getElementById("concertsList");
    toggle?.addEventListener("click", () => {
      const isHidden = list?.hasAttribute("hidden");
      if (isHidden) {
        list?.removeAttribute("hidden");
        toggle.textContent = "Click here to hide the full concerts list";
        toggle.setAttribute("aria-expanded", "true");
        initTimelineAnimations();
      } else {
        list?.setAttribute("hidden", "");
        toggle.textContent = "Click here to view the full concerts list";
        toggle.setAttribute("aria-expanded", "false");
        // Reset animations so they replay on next open
        document.querySelectorAll(".timeline-element.visible").forEach((el) => {
          el.classList.remove("visible");
        });
      }
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      document.querySelector("#interests")?.scrollIntoView({
        behavior: prefersReducedMotion ? "instant" : "smooth",
      });
    });
  }
  initConcertsToggle();
</script>

<style>
  .concerts-toggle {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--color-primary);
    color: var(--color-white);
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
  }

  .concerts-toggle:hover {
    background-color: var(--color-primary-dark);
  }

  /* Timeline container */
  .timeline {
    --icon-size-mobile: 40px;
    --icon-size-desktop: 60px;
    width: 95%;
    max-width: 1170px;
    margin: 0 auto;
    position: relative;
    padding: 2em 0;
    list-style: none;
  }

  /* Vertical line */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    left: 18px;
    height: 100%;
    width: 4px;
    background: #fff;
  }

  /* Mobile: single column — icon | content */
  .timeline-element {
    display: grid;
    grid-template-columns: var(--icon-size-mobile) 1fr;
    gap: 0 1.25em;
    align-items: start;
    margin: 2em 0;
  }

  .timeline-element:first-child {
    margin-top: 0;
  }

  .timeline-element:last-child {
    margin-bottom: 0;
  }

  /* Date — two copies, toggled by viewport */
  .timeline-date {
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.7;
  }

  .timeline-date--desktop {
    display: none;
  }

  .timeline-date--mobile {
    display: inline-block;
    padding: 0.8em 0;
  }

  /* Icon */
  .timeline-icon {
    grid-column: 1;
    grid-row: 1 / 3;
    width: var(--icon-size-mobile);
    height: var(--icon-size-mobile);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1em;
    box-shadow:
      0 0 0 4px #fff,
      inset 0 2px 0 rgba(0, 0, 0, 0.08),
      0 3px 0 4px rgba(0, 0, 0, 0.05);
  }

  .timeline-icon svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  /* Content card */
  .timeline-content {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    background: #fff;
    border-radius: 0.25em;
    padding: 1.5em;
    box-shadow: 0 3px 0 #ddd;
    border-top: 3px solid var(--color-primary);
  }

  .timeline-content h3 {
    margin: 0;
  }

  .timeline-content h4 {
    margin: 0;
  }

  .timeline-content p {
    margin: 1em 0 0;
    line-height: 1.6;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* Arrow pointing to the line */
  .timeline-arrow {
    position: absolute;
    top: 16px;
    right: 100%;
    height: 0;
    width: 0;
    border: 7px solid transparent;
    border-right: 7px solid #fff;
  }

  /* Desktop: three-column — content | icon | date (alternating) */
  @media only screen and (min-width: 1170px) {
    .timeline {
      width: 90%;
    }

    .timeline::before {
      left: 50%;
      margin-left: -2px;
    }

    .timeline-element {
      grid-template-columns: 1fr var(--icon-size-desktop) 1fr;
      grid-template-rows: auto;
      gap: 0 1.5em;
      margin: 4em 0;
    }

    .timeline-element:first-child {
      margin-top: 0;
    }

    .timeline-element:last-child {
      margin-bottom: 0;
    }

    .timeline-icon {
      grid-column: 2;
      grid-row: 1;
      width: var(--icon-size-desktop);
      height: var(--icon-size-desktop);
      justify-self: center;
    }

    .timeline-icon svg {
      width: 28px;
      height: 28px;
    }

    /* Odd: card left, date right */
    .timeline-content {
      grid-column: 1;
      grid-row: 1;
    }

    .timeline-date--mobile {
      display: none;
    }

    .timeline-date--desktop {
      display: block;
      grid-column: 3;
      grid-row: 1;
      font-size: 1rem;
      padding: 0;
      align-self: start;
      line-height: var(--icon-size-desktop);
    }

    .timeline-element:nth-child(even) .timeline-date--desktop {
      grid-column: 1;
      text-align: right;
    }

    .timeline-arrow {
      top: 24px;
      right: auto;
      left: 100%;
      border: 7px solid transparent;
      border-left: 7px solid #fff;
      border-right: none;
    }

    /* Even: card right, date left */
    .timeline-element:nth-child(even) .timeline-content {
      grid-column: 3;
    }

    .timeline-element:nth-child(even) .timeline-arrow {
      left: auto;
      right: 100%;
      border: 7px solid transparent;
      border-right: 7px solid #fff;
      border-left: none;
    }
  }

  /* Animations */
  .timeline-element .timeline-icon,
  .timeline-element .timeline-content {
    opacity: 0;
  }

  .timeline-element.visible .timeline-icon {
    animation: bounce-icon 0.6s forwards;
  }

  .timeline-element.visible .timeline-content {
    animation: slide-in-left 0.6s forwards;
  }

  @media only screen and (min-width: 1170px) {
    .timeline-element:nth-child(even).visible .timeline-content {
      animation: slide-in-right 0.6s forwards;
    }
  }

  @media only screen and (max-width: 1169px) {
    .timeline-element.visible .timeline-content {
      animation: slide-in-right 0.6s forwards;
    }
  }

  @keyframes bounce-icon {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }
    60% {
      opacity: 1;
      transform: scale(1.2);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes slide-in-left {
    0% {
      opacity: 0;
      transform: translateX(-60px);
    }
    60% {
      opacity: 1;
      transform: translateX(10px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slide-in-right {
    0% {
      opacity: 0;
      transform: translateX(60px);
    }
    60% {
      opacity: 1;
      transform: translateX(-10px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-element .timeline-icon,
    .timeline-element .timeline-content {
      opacity: 1;
      animation: none !important;
    }
  }
</style>
