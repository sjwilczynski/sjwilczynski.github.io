---
import type { Podcast } from "@data/types";

export type Props = {
  items: Podcast[];
};

const { items } = Astro.props;
---

<style>
  .podcasts-grid {
    --columnWidth: 220px;
    --columnCount: 3;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--columnWidth), 1fr));
    max-width: calc(var(--columnWidth) * var(--columnCount) + 50px);

    @media (width <= 290px) {
      --columnWidth: 140px;
    }
  }
</style>

<ul class="podcasts-grid">
  {
    items.map((item) => (
      <li>
        <a href={item.url}>{item.title}</a>
      </li>
    ))
  }
</ul>
