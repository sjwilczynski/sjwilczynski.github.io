---
import Navigation from "./navigation/Navigation.astro";
import AboutSection from "./sections/about/AboutSection.astro";
import ResumeListView from "@layouts/ResumeListView.astro";
import ProjectsList from "@layouts/ProjectsList.astro";
import ResumeSection from "@layouts/ResumeSection.astro";
import Skills from "./sections/skills/Skills.astro";
import InterestsEn from "./sections/interests/InterestsEn.mdx";
import InterestsPl from "./sections/interests/InterestsPl.mdx";
import ThemeToggle from "./theme/ThemeToggle.astro";
import LanguageToggle from "./i18n/LanguageToggle.astro";
import "@styles/global.css";
import { getData } from "@data/getData";
import { useTranslations, type Lang } from "@i18n/ui";

export type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);

const sections = {
  about: t("nav.about"),
  experience: t("nav.experience"),
  education: t("nav.education"),
  projects: t("nav.projects"),
  research: t("nav.research"),
  skills: t("nav.skills"),
  achievements: t("nav.achievements"),
  interests: t("nav.interests"),
};

const {
  about,
  experienceResumeItems,
  educationResumeItems,
  researchResumeItems,
  projectEntries,
  achievementResumeList,
  skillsResumeLists,
  socialMedias,
  concerts,
  podcasts,
} = await getData(lang);

const fullName = about.name + " " + about.surname;
const cvPdfHref = lang === "pl" ? "/cv-pl.pdf" : "/cv.pdf";
const cvPdfTitle = t("cta.downloadCv");
const Interests = lang === "pl" ? InterestsPl : InterestsEn;
---

<Navigation
  sections={sections}
  fullName={fullName}
  toggleLabel={t("nav.toggle")}
>
  <Fragment slot="preferences">
    <LanguageToggle lang={lang} />
    <ThemeToggle label={t("theme.toggleAria")} title={t("theme.toggleTitle")} />
  </Fragment>
</Navigation>
<main>
  <ResumeSection id="about">
    <AboutSection
      about={about}
      socialMedias={socialMedias}
      cvPdfHref={cvPdfHref}
      cvPdfTitle={cvPdfTitle}
    />
  </ResumeSection>

  <ResumeSection
    id="experience"
    title={sections.experience}
    resumeItems={experienceResumeItems}
  />

  <ResumeSection
    id="education"
    title={sections.education}
    resumeItems={educationResumeItems}
  />

  <ResumeSection id="projects" title={sections.projects}>
    <ProjectsList projects={projectEntries} />
    {t("projects.moreCodePrefix")}<a href={about.githubUrl}
      >{t("projects.moreCodeLink")}</a
    >
  </ResumeSection>

  <ResumeSection
    id="research"
    title={sections.research}
    resumeItems={researchResumeItems}
  />

  <ResumeSection id="skills" title={sections.skills}>
    {skillsResumeLists.map((skills) => <Skills skills={skills} />)}
  </ResumeSection>

  <ResumeSection id="achievements" title={sections.achievements}>
    <ResumeListView {...achievementResumeList} />
  </ResumeSection>

  <ResumeSection id="interests" title={sections.interests}>
    <Interests concerts={concerts} podcasts={podcasts} />
  </ResumeSection>
</main>
