---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

export type Props = {
  fullName: string;
  title: string;
  description?: string;
  /** Path (site-root relative) to the social share image. */
  image?: string;
  /** Open Graph object type, e.g. "website" or "profile". */
  ogType?: string;
  noindex?: boolean;
  /** schema.org JSON-LD object injected as <script type="application/ld+json">. */
  structuredData?: Record<string, unknown>;
  theme?: boolean;
  /** Page locale; controls <html lang> upstream and og:locale here. */
  lang?: "en" | "pl";
  /** hreflang alternates for bilingual pages. */
  alternates?: { hreflang: string; href: string }[];
};

const DEFAULT_DESCRIPTION =
  "Stanisław Wilczyński — full-stack developer based in Wrocław, Poland. Resume with experience, projects, skills and achievements.";

const {
  fullName,
  title,
  description = DEFAULT_DESCRIPTION,
  image = "/img/og-image.png",
  ogType = "website",
  noindex = false,
  structuredData,
  theme = false,
  lang = "en",
  alternates = [],
} = Astro.props;

// Applied before first paint, and re-applied after every <ClientRouter /> swap,
// to keep the chosen theme. During a navigation Astro copies the incoming
// page's <html> attributes onto the persistent element, which drops the
// client-only `dark` class (the static HTML never carries it) and would reset
// the page to light. Re-running this on astro:after-swap — synchronously,
// before the browser paints and before the transition captures the new
// snapshot — restores it with no flash. On the initial hard load the
// render-blocking stylesheet guarantees the first paint is already themed.
const themeScript = `(function(){function a(){try{var s=localStorage.getItem("theme");var d=s?s==="dark":window.matchMedia("(prefers-color-scheme: dark)").matches;document.documentElement.classList.toggle("dark",d);}catch(e){}}a();document.addEventListener("astro:after-swap",a);})();`;

const site = Astro.site ?? new URL("https://sjwilczynski.github.io");
const canonicalURL = new URL(Astro.url.pathname, site).href;
const imageURL = new URL(image, site).href;
const imageAlt = `${fullName} — Full-Stack Developer`;
const ogLocale = lang === "pl" ? "pl_PL" : "en_US";
const ogLocaleAlt = lang === "pl" ? "en_US" : "pl_PL";
---

<head>
  {theme && <script is:inline set:html={themeScript} />}
  <ClientRouter />
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, shrink-to-fit=no"
  />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={fullName} />
  <meta name="theme-color" content="#4479a2" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalURL} />
  {
    alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))
  }

  <link rel="shortcut icon" href="/img/favicon.ico" />
  <Font cssVariable="--font-heading" preload />
  <Font cssVariable="--font-body" preload />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={fullName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={ogLocale} />
  {
    alternates.length > 0 && (
      <meta property="og:locale:alternate" content={ogLocaleAlt} />
    )
  }
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
  <meta name="twitter:image:alt" content={imageAlt} />

  {
    structuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )
  }
</head>
