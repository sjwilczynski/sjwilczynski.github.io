---
import face from "./face.webp";
import { Image } from "astro:assets";

export type Props = {
  fullName: string;
  sections: {
    [key: string]: string;
  };
};

const { sections, fullName } = Astro.props;
const firstSectionKey = Object.keys(sections)[0];
const sectionEntries = Object.entries(sections);
---

<script>
  // Hamburger toggle
  const toggler = document.querySelector<HTMLButtonElement>(".nav-toggler");
  const navMenu = document.querySelector<HTMLElement>(".nav-menu");
  toggler?.addEventListener("click", () => {
    const isOpen = navMenu?.classList.toggle("open");
    toggler.setAttribute("aria-expanded", String(!!isOpen));
  });

  // Auto-close on link click (mobile)
  navMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      navMenu.classList.remove("open");
      toggler?.setAttribute("aria-expanded", "false");
    });
  });

  // IntersectionObserver scrollspy
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("#sideNav a.nav-link");
  const sections = document.querySelectorAll<HTMLElement>("section[id]");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove("active"));
          const activeLink = document.querySelector<HTMLAnchorElement>(
            `#sideNav a.nav-link[href="#${entry.target.id}"]`,
          );
          activeLink?.classList.add("active");
        }
      });
    },
    { rootMargin: "-20% 0px -80% 0px" },
  );

  sections.forEach((section) => observer.observe(section));
</script>

<nav id="sideNav">
  <a class="nav-brand" href={"#" + firstSectionKey}>
    <span class="brand-text">{fullName}</span>
    <span class="brand-image">
      <Image
        class="img-profile"
        src={face}
        alt="Face"
        format="webp"
        width={160}
        height={160}
        loading="eager"
      />
    </span>
  </a>
  <button
    class="nav-toggler"
    type="button"
    aria-expanded="false"
    aria-label="Toggle navigation"
  >
    <span class="toggler-icon"></span>
  </button>
  <div class="nav-menu">
    <ul>
      {
        sectionEntries.map((keyValue) => (
          <li>
            <a class="nav-link" href={"#" + keyValue[0]}>
              {keyValue[1]}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  #sideNav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1030;
    background-color: var(--color-primary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    padding: 0.25rem 0.5rem;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    color: var(--color-white);
    text-decoration: none;
    padding: 0.3125rem 0;
    font-size: 1.25rem;

    &:hover,
    &:focus,
    &:active {
      color: var(--color-white);
      text-decoration: none;
    }
  }

  .brand-image {
    display: none;
  }

  .brand-text {
    display: block;
  }

  .img-profile {
    max-width: 10rem;
    max-height: 10rem;
    border-radius: 50%;
    border: 0.5rem solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
  }

  .nav-toggler {
    display: flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.375rem;
    margin-left: auto;
    cursor: pointer;

    &:focus {
      outline-color: #6a9fc8;
    }
  }

  .toggler-icon {
    display: block;
    width: 1.5em;
    height: 1.5em;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.55%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100%;
  }

  .nav-menu {
    display: none;
    width: 100%;

    &.open {
      display: block;
    }
  }

  .nav-menu ul {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 800;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
    text-decoration: none;

    &:hover,
    &:focus,
    &.active {
      color: var(--color-white);
      text-decoration: none;
    }
  }

  /* Desktop sidebar */
  @media (min-width: 992px) {
    #sideNav {
      flex-direction: column;
      width: var(--sidebar-width);
      height: 100vh;
      right: auto;
      text-align: center;
      padding: 0;
    }

    .nav-brand {
      display: flex;
      margin: auto auto 0;
      padding: 0.5rem;
    }

    .brand-text {
      display: none;
    }

    .brand-image {
      display: block;
    }

    .nav-toggler {
      display: none;
    }

    .nav-menu {
      display: flex;
      align-items: flex-start;
      flex-grow: 0;
      width: 100%;
      margin-bottom: auto;
    }

    .nav-menu ul {
      width: 100%;
    }

    .nav-link {
      padding: 0.5rem 1rem;
    }
  }
</style>
