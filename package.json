{
  "name": "cv-experiments",
  "version": "0.8.0",
  "private": true,
  "homepage": "https://sjwilczynski.github.io",
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "astro:build": "astro build",
    "build": "bun run astro:build && bun run size",
    "check": "astro check",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:watch": "astro check --watch",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run tsc && bun run check:i18n && bun run build",
    "dev": "bun run --parallel check:watch start",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint ./src",
    "og": "node scripts/generate-og-image.js",
    "pdf": "bun run astro:build && node scripts/generate-pdf.js",
    "preview": "astro preview",
    "size": "size-limit",
    "start": "astro dev",
    "test:e2e": "playwright test",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.3.1",
    "astro-icon": "1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-app": "^13.0.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "size-limit": "^13.0.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "size-limit": [
    {
      "name": "CSS",
      "path": "dist/**/*.css",
      "limit": "6 KB"
    },
    {
      "name": "JS",
      "path": "dist/**/*.js",
      "limit": "6 KB"
    }
  ]
}
