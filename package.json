{
  "name": "cv-experiments",
  "version": "0.8.0",
  "private": true,
  "homepage": "https://sjwilczynski.github.io",
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "astro:build": "astro build",
    "build": "bun run astro:build && bun run size",
    "check": "astro check",
    "check:watch": "astro check --watch",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run tsc && bun run build",
    "dev": "bun run --parallel check:watch start",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint ./src",
    "og": "node scripts/generate-og-image.js",
    "pdf": "bun run astro:build && node scripts/generate-pdf.js",
    "preview": "astro preview",
    "size": "size-limit",
    "start": "astro dev",
    "test:e2e": "playwright test",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie < 11"
  ],
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/mdx": "5.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "6.4.6",
    "astro-icon": "1.1.5",
    "baseline-browser-mapping": "^2.10.18",
    "caniuse-lite": "^1.0.30001787"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@playwright/test": "^1.59.1",
    "@size-limit/preset-app": "^12.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "size-limit": "^12.0.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "size-limit": [
    {
      "path": "dist/**/*.css",
      "limit": "6 KB"
    }
  ]
}
